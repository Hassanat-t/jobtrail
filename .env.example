# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://jobtrail:jobtrail@localhost:5434/jobtrail
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3020

# Follow-up reminders. Vercel Cron sends CRON_SECRET; any long random string works.
CRON_SECRET=generate-a-long-random-string
# Leave empty locally: reminder emails are printed to the terminal instead of sent.
RESEND_API_KEY=
# e.g. JobTrail <reminders@yourdomain.com>. Defaults to Resend's test sender.
EMAIL_FROM=

# Local test account used when checking the app in a browser (dev only, not a real account).
DEV_TEST_EMAIL=tester@jobtrail.test
DEV_TEST_PASSWORD=paper-trail-2026
